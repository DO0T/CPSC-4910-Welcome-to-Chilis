DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# eBay Browse API credentials stay on the server. Use the matching sandbox or production keyset.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Leave the eBay credentials blank to keep using DummyJSON sample search.
# On EC2, set EBAY_SECRET_ID to load a JSON secret instead of using the credentials above.
# The secret must contain EBAY_CLIENT_ID and EBAY_CLIENT_SECRET; EBAY_ENVIRONMENT is optional.
# Configure AWS_REGION to match the secret's region, and give the EC2 role access to that secret.
EBAY_SECRET_ID=
AWS_REGION=
